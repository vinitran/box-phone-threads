+package vn.romprofiles;
+
+import java.io.*;
+import java.net.*;
+import java.nio.charset.StandardCharsets;
+import java.util.*;
+import javax.net.ssl.*;
+
+/** An authenticated CONNECT must carry a verified HTTPS response, not just return 200. */
+public final class HttpsProxyProbe {
+    private static final String HOST="api.ipify.org";
+    private static final int LIMIT=128;
+    private HttpsProxyProbe(){}
+
+    public static String test(Socket upstream,String authorization)throws Exception{
+        Timer deadline=new Timer("proxy-probe-deadline",true);
+        deadline.schedule(new TimerTask(){public void run(){try{upstream.close();}catch(IOException ignored){}}},40000);
+        try{return request(upstream,authorization);}finally{deadline.cancel();}
+    }
+    private static String request(Socket upstream,String authorization)throws Exception{
+        upstream.setSoTimeout(12000);
+        write(upstream,"CONNECT "+HOST+":443 HTTP/1.1\r\nHost: "+HOST+":443\r\n"+authorization+"\r\n");
+        Response connect=headers(upstream.getInputStream());
+        if(connect.status!=200)throw new IOException("Upstream proxy CONNECT status "+connect.status);
+        SSLSocketFactory factory=(SSLSocketFactory)SSLSocketFactory.getDefault();
+        try(SSLSocket tls=(SSLSocket)factory.createSocket(upstream,HOST,443,true)){
+            tls.setSoTimeout(12000);
+            SSLParameters parameters=tls.getSSLParameters();
+            parameters.setEndpointIdentificationAlgorithm("HTTPS");
+            parameters.setServerNames(Collections.singletonList(new SNIHostName(HOST)));
+            tls.setSSLParameters(parameters);tls.startHandshake();
+            // Proxy credentials are sent only to CONNECT, never inside the HTTPS request.
+            write(tls,"GET / HTTP/1.1\r\nHost: "+HOST+"\r\nAccept: text/plain\r\nAccept-Encoding: identity\r\nConnection: close\r\n\r\n");
+            InputStream input=tls.getInputStream();Response response=headers(input);
+            if(response.status!=200)throw new IOException("HTTPS probe status "+response.status);
+            String ip=body(input,response).trim();
+            if(!validIP(ip))throw new IOException("HTTPS probe returned an invalid IP address");
+            return ip;
+        }
+    }
+    private static void write(Socket socket,String value)throws IOException{
+        socket.getOutputStream().write(value.getBytes(StandardCharsets.ISO_8859_1));socket.getOutputStream().flush();
+    }
+    private static class Response {
+        int status;Map<String,String> fields=new HashMap<>();
+    }
+    private static String line(InputStream input,int limit)throws IOException{
+        ByteArrayOutputStream out=new ByteArrayOutputStream();
+        while(out.size()<limit){
+            int b=input.read();if(b<0)throw new EOFException("Incomplete HTTPS probe response");
+            if(b=='\n'){
+                byte[] bytes=out.toByteArray();
+                if(bytes.length==0||bytes[bytes.length-1]!='\r')throw new IOException("Invalid HTTP line");
+                return new String(bytes,0,bytes.length-1,StandardCharsets.ISO_8859_1);
+            }
+            out.write(b);
+        }
+        throw new IOException("HTTPS probe header too large");
+    }
+    private static Response headers(InputStream input)throws IOException{
+        Response response=new Response();String first=line(input,4096);String[] parts=first.split(" ",3);
+        if(parts.length<2||!parts[0].matches("HTTP/1\\.[01]")||!parts[1].matches("[0-9]{3}"))throw new IOException("Invalid HTTP status");
+        response.status=Integer.parseInt(parts[1]);int total=first.length();
+        while(total<32768){
+            String field=line(input,4096);total+=field.length()+2;if(field.isEmpty())return response;
+            int colon=field.indexOf(':');if(colon<1)throw new IOException("Invalid HTTP header");
+            String key=field.substring(0,colon).trim().toLowerCase(Locale.ROOT);
+            if(response.fields.put(key,field.substring(colon+1).trim())!=null&&(key.equals("content-length")||key.equals("transfer-encoding")))throw new IOException("Ambiguous HTTP framing");
+        }
+        throw new IOException("HTTPS probe header too large");
+    }
+    private static int size(String value,int radix)throws IOException{
+        try{long n=Long.parseLong(value,radix);if(n<0||n>LIMIT)throw new NumberFormatException();return (int)n;}
+        catch(NumberFormatException e){throw new IOException("HTTPS probe body too large or invalid");}
+    }
+    private static void read(InputStream input,ByteArrayOutputStream output,int count)throws IOException{
+        if(output.size()+count>LIMIT)throw new IOException("HTTPS probe body too large");
+        for(int i=0;i<count;i++){int b=input.read();if(b<0)throw new EOFException("Incomplete HTTPS probe body");output.write(b);}
+    }
+    private static String body(InputStream input,Response response)throws IOException{
+        ByteArrayOutputStream output=new ByteArrayOutputStream();
+        String transfer=response.fields.get("transfer-encoding"),length=response.fields.get("content-length");
+        if(transfer!=null){
+            if(length!=null||!transfer.equalsIgnoreCase("chunked"))throw new IOException("Unsupported HTTP framing");
+            int chunks=0;
+            while(++chunks<=LIMIT+1){
+                String chunk=line(input,256).split(";",2)[0];int n=size(chunk.trim(),16);
+                if(n==0){
+                    int trailers=0;String trailer;
+                    do{trailer=line(input,4096);trailers+=trailer.length()+2;if(trailers>32768)throw new IOException("HTTPS probe trailers too large");}while(!trailer.isEmpty());
+                    return output.toString("US-ASCII");
+                }
+                read(input,output,n);if(!line(input,2).isEmpty())throw new IOException("Invalid chunk terminator");
+            }
+            throw new IOException("Too many HTTPS probe chunks");
+        }
+        if(length!=null)read(input,output,size(length,10));
+        else{int b;while((b=input.read())!=-1){if(output.size()>=LIMIT)throw new IOException("HTTPS probe body too large");output.write(b);}}
+        return output.toString("US-ASCII");
+    }
+    private static boolean validIP(String ip){
+        if(ip.matches("[0-9a-fA-F:]+")&&ip.contains(":")){
+            try{return InetAddress.getByName(ip) instanceof Inet6Address;}catch(Exception ignored){return false;}
+        }
+        String[] parts=ip.split("\\.",-1);if(parts.length!=4)return false;
+        for(String part:parts)if(!part.matches("[0-9]{1,3}")||Integer.parseInt(part)>255)return false;
+        return true;
+    }
+}
