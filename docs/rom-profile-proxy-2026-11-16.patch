+#!/usr/bin/env python3
+"""Exercise the production HTTPS proxy probe against local CONNECT/TLS fixtures; no ADB."""
+from pathlib import Path
+import socketserver,ssl,subprocess,tempfile,threading
+
+SOURCE=Path(__file__).resolve().parents[1]/'profile-manager/src/vn/romprofiles/HttpsProxyProbe.java'
+HARNESS='''import vn.romprofiles.HttpsProxyProbe;import java.net.*;
+public class ProbeTest { public static void main(String[] args)throws Exception{
+ try(Socket socket=new Socket("127.0.0.1",Integer.parseInt(args[0]))){
+  System.out.println(HttpsProxyProbe.test(socket,"Proxy-Authorization: Basic Zml4dHVyZTpzZWNyZXQ=\\r\\n"));
+ }catch(Exception e){System.out.println("REJECTED: "+e.getClass().getSimpleName()+": "+e.getMessage());System.exit(1);}
+}}'''
+
+def headers(sock):
+    data=b''
+    while not data.endswith(b'\r\n\r\n'):
+        part=sock.recv(1)
+        if not part:raise EOFError()
+        data+=part
+        if len(data)>32768:raise AssertionError('Oversized request')
+    return data
+
+def run(command):
+    return subprocess.run(list(map(str,command)),check=True,capture_output=True,text=True)
+
+class Server(socketserver.TCPServer):allow_reuse_address=True
+
+with tempfile.TemporaryDirectory(prefix='rom-proxy-qa-') as temporary:
+    directory=Path(temporary)
+    (directory/'ProbeTest.java').write_text(HARNESS)
+    run(['javac','-d',directory,SOURCE,directory/'ProbeTest.java'])
+    run(['openssl','req','-x509','-newkey','rsa:2048','-nodes','-keyout',directory/'ca.key','-out',directory/'ca.crt','-days','1','-subj','/CN=Local fixture CA'])
+    for name,hostname in [('good','api.ipify.org'),('wrong','wrong.example')]:
+        run(['openssl','req','-newkey','rsa:2048','-nodes','-keyout',directory/(name+'.key'),'-out',directory/(name+'.csr'),'-subj','/CN='+hostname])
+        (directory/(name+'.ext')).write_text('subjectAltName=DNS:'+hostname+'\nextendedKeyUsage=serverAuth\n')
+        run(['openssl','x509','-req','-in',directory/(name+'.csr'),'-CA',directory/'ca.crt','-CAkey',directory/'ca.key','-CAcreateserial','-out',directory/(name+'.crt'),'-days','1','-extfile',directory/(name+'.ext')])
+    run(['keytool','-importcert','-noprompt','-alias','fixture','-file',directory/'ca.crt','-keystore',directory/'trust.jks','-storepass','fixture-only'])
+    cases=[
+        ('content-length',b'HTTP/1.1 200 OK\r\nContent-Length: 12\r\n\r\n203.0.113.10',True),
+        ('chunked',b'HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\nB\r\n2001:db8::1\r\n0\r\n\r\n',True),
+        ('connection-close',b'HTTP/1.1 200 OK\r\n\r\n203.0.113.10',True),
+        ('407',b'',False),('connect-only',b'',False),
+        ('untrusted-certificate',b'',False),('wrong-hostname',b'',False),
+        ('http-503',b'HTTP/1.1 503 Unavailable\r\nContent-Length: 0\r\n\r\n',False),
+        ('html-body',b'HTTP/1.1 200 OK\r\n\r\n<html>Login required</html>',False),
+        ('invalid-ip',b'HTTP/1.1 200 OK\r\n\r\n999.2.3.4',False),
+        ('truncated',b'HTTP/1.1 200 OK\r\nContent-Length: 12\r\n\r\n203.0',False),
+        ('oversized',b'HTTP/1.1 200 OK\r\nContent-Length: 999999\r\n\r\n',False),
+        ('ambiguous-framing',b'HTTP/1.1 200 OK\r\nContent-Length: 12\r\nTransfer-Encoding: chunked\r\n\r\n',False),
+    ]
+    for name,response,expected in cases:
+        observed=[];failures=[]
+        class Handler(socketserver.BaseRequestHandler):
+            def handle(self):
+                try:
+                    self.request.settimeout(5)
+                    connect=headers(self.request);observed.append(connect)
+                    assert connect.startswith(b'CONNECT api.ipify.org:443 HTTP/1.1\r\n')
+                    assert b'Proxy-Authorization: Basic Zml4dHVyZTpzZWNyZXQ=' in connect
+                    if name=='407':self.request.sendall(b'HTTP/1.1 407 Proxy Authentication Required\r\n\r\n');return
+                    self.request.sendall(b'HTTP/1.1 200 Connection Established\r\n\r\n')
+                    if name=='connect-only':return
+                    context=ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
+                    cert='wrong' if name=='wrong-hostname' else 'good'
+                    context.load_cert_chain(directory/(cert+'.crt'),directory/(cert+'.key'))
+                    with context.wrap_socket(self.request,server_side=True) as tls:
+                        request=headers(tls);observed.append(request)
+                        assert request.startswith(b'GET / HTTP/1.1\r\nHost: api.ipify.org\r\n')
+                        assert b'Authorization' not in request and b'Zml4dHVyZTpzZWNyZXQ=' not in request
+                        tls.sendall(response)
+                except (ssl.SSLError,EOFError,ConnectionError):pass
+                except Exception as error:failures.append(error)
+        with Server(('127.0.0.1',0),Handler) as server:
+            thread=threading.Thread(target=server.handle_request,daemon=True);thread.start()
+            command=['java']
+            if name!='untrusted-certificate':command+=['-Djavax.net.ssl.trustStore='+str(directory/'trust.jks'),'-Djavax.net.ssl.trustStorePassword=fixture-only']
+            result=subprocess.run(command+['-cp',str(directory),'ProbeTest',str(server.server_address[1])],capture_output=True,text=True,timeout=15)
+            thread.join(6)
+        assert not thread.is_alive() and not failures,(name,failures)
+        assert (result.returncode==0)==expected,(name,result.stdout,result.stderr)
+        assert observed,(name,'Probe did not use the configured proxy')
+        if expected:assert len(observed)==2
+        if name=='407':assert 'CONNECT status 407' in result.stdout
+        print('PASS:',name)
+    print('PASS: 13 production CONNECT/TLS/HTTP/IP cases; credentials only sent to proxy')
