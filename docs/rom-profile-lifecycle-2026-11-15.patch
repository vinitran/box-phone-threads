+#!/usr/bin/env python3
+"""Run the real deletion orchestrator against deterministic Android/storage fixtures; no ADB."""
+from pathlib import Path
+import subprocess,tempfile
+source=Path(__file__).resolve().parents[1]/'profile-manager/src/vn/romprofiles/ProfileDeletion.java'
+program=r'''import vn.romprofiles.ProfileDeletion;
+import java.util.*;
+public class DeletionWorkflowTest {
+ static final String A="11111111-1111-4111-8111-111111111111", B="22222222-2222-4222-8222-222222222222";
+ static class Ops implements ProfileDeletion.Operations {
+  int active=15,backup=0,remove=0,retire=0; boolean pending=false,exists=true,failBackup=false,timeoutAfterCommit=false,leavePresent=false,reuseAfterBackup=false,activateAfterBackup=false,failRetire=false,generationChanged=false,changeGenerationAfterBackup=false;
+  String id=A;
+  public int currentUser(){return active;}
+  public String profileId(int u){if(generationChanged)throw new IllegalArgumentException("Android user generation changed");return id;}
+  public boolean pending(int u){return pending;}
+  public void backup(int u)throws Exception{backup++;if(failBackup)throw new Exception("archive verification failed");if(reuseAfterBackup)id=B;if(activateAfterBackup)active=u;if(changeGenerationAfterBackup)generationChanged=true;}
+  public void markPending(int u){pending=true;}
+  public void removeUser(int u)throws Exception{remove++;if(!leavePresent)exists=false;if(timeoutAfterCommit)throw new Exception("lost response after commit");}
+  public boolean userExists(int u){return exists;}
+  public void retire(int u,String expected)throws Exception{if(failRetire)throw new Exception("storage commit failed");check(id.equals(expected));retire++;pending=false;}
+ }
+ static void check(boolean value){if(!value)throw new AssertionError();}
+ interface Call {void run()throws Exception;}
+ static void rejects(Call c)throws Exception{try{c.run();throw new AssertionError("must reject");}catch(IllegalArgumentException expected){}}
+ static void pending(Call c)throws Exception{try{c.run();throw new AssertionError("must reconcile");}catch(ProfileDeletion.Pending expected){}}
+ public static void main(String[] args)throws Exception{
+  Ops o=new Ops();rejects(()->ProfileDeletion.run(0,A,true,o));rejects(()->ProfileDeletion.run(15,A,true,o));rejects(()->ProfileDeletion.run(10,A,false,o));rejects(()->ProfileDeletion.run(10,B,true,o));check(o.backup==0&&o.remove==0);
+  Ops fail=new Ops();fail.failBackup=true;try{ProfileDeletion.run(10,A,true,fail);throw new AssertionError();}catch(Exception expected){check(fail.backup==1&&fail.remove==0&&!fail.pending);}
+  Ops commit=new Ops();commit.timeoutAfterCommit=true;ProfileDeletion.run(10,A,true,commit);check(commit.backup==1&&commit.remove==1&&commit.retire==1);
+  Ops async=new Ops();async.leavePresent=true;pending(()->ProfileDeletion.run(10,A,true,async));pending(()->ProfileDeletion.run(10,A,true,async));check(async.backup==1&&async.remove==1&&async.pending);check(!ProfileDeletion.reconcile(10,A,async));check(async.remove==1);async.exists=false;check(ProfileDeletion.reconcile(10,A,async));check(async.retire==1&&async.remove==1);
+  Ops reuse=new Ops();reuse.reuseAfterBackup=true;rejects(()->ProfileDeletion.run(10,A,true,reuse));check(reuse.remove==0&&!reuse.pending);
+  Ops active=new Ops();active.activateAfterBackup=true;rejects(()->ProfileDeletion.run(10,A,true,active));check(active.remove==0&&!active.pending);
+  Ops generation=new Ops();generation.changeGenerationAfterBackup=true;rejects(()->ProfileDeletion.run(10,A,true,generation));check(generation.remove==0&&!generation.pending);
+  Ops storage=new Ops();storage.failRetire=true;pending(()->ProfileDeletion.run(10,A,true,storage));storage.failRetire=false;check(ProfileDeletion.reconcile(10,A,storage));check(storage.remove==1&&storage.retire==1);
+  System.out.println("PASS: owner/active/confirmation/UUID guards, backup failure, UUID reuse, active-user race, unknown removal, no duplicate deletion, deferred retirement");
+ }
+}'''
