+package vn.romprofiles;
+
+import java.io.IOException;
+import java.util.UUID;
+
+/** Pure orchestration: archive first, bind the exact UUID, never repeat an uncertain removal. */
+public final class ProfileDeletion {
+    public interface Operations {
+        int currentUser() throws Exception;
+        String profileId(int uid) throws Exception;
+        boolean pending(int uid) throws Exception;
+        void backup(int uid) throws Exception;
+        void markPending(int uid) throws Exception;
+        void removeUser(int uid) throws Exception;
+        boolean userExists(int uid) throws Exception;
+        void retire(int uid, String id) throws Exception;
+    }
+    public static final class Pending extends IOException {
+        public Pending(){super("Deletion result not yet confirmed; reconcile state before any retry");}
+    }
+    private static void validate(int uid,String expected,boolean confirmed,Operations ops)throws Exception{
+        if(uid<=0)throw new IllegalArgumentException("Owner cannot be deleted");
+        if(!confirmed)throw new IllegalArgumentException("Explicit deletion confirmation is required");
+        if(expected==null)throw new IllegalArgumentException("Expected profile UUID is required");
+        UUID.fromString(expected);
+        if(!expected.equals(ops.profileId(uid)))throw new IllegalArgumentException("Profile UUID changed");
+        if(uid==ops.currentUser())throw new IllegalArgumentException("Switch to another profile before deleting");
+    }
+    public static void run(int uid,String expected,boolean confirmed,Operations ops)throws Exception{
+        validate(uid,expected,confirmed,ops);
+        if(ops.pending(uid))throw new Pending();
+        ops.backup(uid);  // Must finish and verify the archive before Android is asked to remove anything.
+        validate(uid,expected,confirmed,ops);
+        ops.markPending(uid);
+        try {
+            validate(uid,expected,confirmed,ops);
+            ops.removeUser(uid);
+        } catch(Exception ignored) {
+            // The command can fail after committing. Only read-back may settle the result.
+        }
+        try {
+            if(!ops.userExists(uid)){ops.retire(uid,expected);return;}
+        } catch(Exception ignored) {}
+        throw new Pending();
+    }
+    public static boolean reconcile(int uid,String id,Operations ops)throws Exception{
+        if(!ops.pending(uid))return true;
+        if(ops.userExists(uid))return false;
+        ops.retire(uid,id);return true;
+    }
+}
